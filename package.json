{
  "name": "nato-phonetics",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "react-native start",
    "generate-icons": "node ./scripts/generate-icons.js",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "node scripts/build-web.cjs --serve",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "export:web": "node scripts/build-web.cjs",
    "package:web": "node scripts/package-web.cjs",
    "check:dependencies": "node scripts/check-no-expo.cjs",
    "audit:review": "node scripts/check-audit.cjs",
    "build:android": "node scripts/build-native.cjs android-debug",
    "build:android:release": "node scripts/build-native.cjs android-release",
    "build:ios": "node scripts/build-native.cjs ios-simulator",
    "build:android:debug": "node scripts/build-native.cjs android-debug",
    "build:ios:simulator": "node scripts/build-native.cjs ios-simulator",
    "build:ios:archive": "node scripts/build-native.cjs ios-archive",
    "build:ios:export": "node scripts/build-native.cjs ios-export",
    "ios:pods": "bundle exec pod install --project-directory=ios",
    "postinstall": "node scripts/patch-native-tts.cjs && node scripts/patch-native-yoga.cjs",
    "check:yoga": "node scripts/verify-yoga-rounding.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-tts": "4.1.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@types/react": "~19.1.0",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.23.0 <23",
    "npm": ">=10.9.4 <11"
  },
  "packageManager": "npm@10.9.4"
}
