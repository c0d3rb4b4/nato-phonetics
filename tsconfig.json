{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "app/**/*.js",
    "src/**/*.js",
    "src/**/*.ts",
    "index.js",
    "index.web.js"
  ]
}
