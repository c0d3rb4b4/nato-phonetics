"""Actual untouched Release tile capture using a separate native observer."""
from pathlib import Path
import hashlib,importlib.util,json,os,re,subprocess,sys,time

ROOT=Path(__file__).resolve().parents[4];OUT=Path(__file__).resolve().parent
spec=importlib.util.spec_from_file_location('native',ROOT/'docs/evidence/run08/android/verify_native.py')
m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
m.OUT=OUT;m.SHOTS=OUT.parent/'screenshots/android';m.ADB='/Users/mac/Library/Android/sdk/platform-tools/adb'
m.checks=json.loads((OUT/'checks.json').read_text()) if (OUT/'checks.json').exists() else []
m.captures=json.loads((m.SHOTS/'metadata.json').read_text()) if (m.SHOTS/'metadata.json').exists() else []
REMOTE='/sdcard/Android/data/com.natophonetics.app/files/tile-observer'
APK=ROOT/'artifacts/run27/release-arm64/app-release-local-test.apk'
TEST=ROOT/'artifacts/run30/instrumentation/font-composition.apk'

def wait_file(name,timeout=15):
    end=time.monotonic()+timeout
    while time.monotonic()<end:
        value=m.adb('shell','ls',REMOTE) if m.adb('shell',f'test -d {REMOTE} && echo yes || true').strip() else ''
        if name in value.split():return json.loads(m.adb('exec-out','cat',REMOTE+'/'+name))
        if 'error.json' in value.split():raise AssertionError(m.adb('exec-out','cat',REMOTE+'/error.json'))
        time.sleep(.2)
    raise AssertionError('Missing native observation: '+name)

def request(name,finish=False):
    data=json.dumps({'name':name,'finish':finish}).encode()
    m.adb('shell',f'cat > {REMOTE}/request.tmp && mv {REMOTE}/request.tmp {REMOTE}/request.json',input=data)
    if not finish:wait_file(name+'-done.json')

def snapshot(name,theme,scale):
    request(name)
    row=json.loads(m.adb('exec-out','cat',REMOTE+'/'+name+'.json'))
    assert abs(row['dimensions']['fontScale']-scale)<1e-6
    row['candidateSha256']=hashlib.sha256(APK.read_bytes()).hexdigest()
    (OUT/(name+'-native-layout.json')).write_text(json.dumps(row,indent=2)+'\n')
    m.screenshot(name,'Exact production Release; native Layout/spans/transforms; no inspector',theme)
    density=row['dimensions']['density'];rectangles=[]
    for n in row['values']:
        if not re.fullmatch(r'alphabet-[A-Z]|converter-\d+|quiz-card',n['id']):continue
        f=n['frame'];v=f['visible']
        if f['shown'] and abs((v[2]-v[0])-110*scale*density)<=2 and abs((v[3]-v[1])-150*scale*density)<=2:
            rectangles.append({'testID':n['id'],'pixels':{'x':f['x'],'y':f['y'],'width':f['width'],'height':f['height']}})
    m.mark(name,scale=scale,density=density,tiles=rectangles)
    return {r['testID'] for r in rectangles}

def start():
    for apk in [APK,TEST]:m.adb('install','-r',str(apk))
    installed=m.adb('shell','pm','path',m.APP).strip().removeprefix('package:')
    assert m.adb('shell','sha256sum',installed).split()[0]==hashlib.sha256(APK.read_bytes()).hexdigest()
    runas=subprocess.run([m.ADB,'-s',m.SERIAL,'shell','run-as',m.APP,'id'],capture_output=True,text=True)
    assert runas.returncode!=0 and 'not debuggable' in runas.stdout+runas.stderr
    m.adb('shell','rm','-rf',REMOTE) # owned observer output only; never product preferences/data
    m.adb('shell','settings','put','system','font_scale','1')
    log=(OUT/'observer-session.log').open('w')
    process=subprocess.Popen([m.ADB,'-s',m.SERIAL,'shell','am','instrument','-w',
        'com.natophonetics.fonttest/com.natophonetics.fonttest.TileLayoutInstrumentation'],stdout=log,stderr=subprocess.STDOUT)
    wait_file('ready.json',45)
    (OUT/'identity.json').write_text(json.dumps({'candidateSha256':hashlib.sha256(APK.read_bytes()).hexdigest(),
        'testApkSha256':hashlib.sha256(TEST.read_bytes()).hexdigest(),'nonDebuggable':True,'runAsExit':runas.returncode,
        'metro':'not used; exact embedded Hermes product entry','appDataCleared':False},indent=2)+'\n')
    return process,log

def scroll(up=True):
    png=m.adb('exec-out','screencap','-p',raw=True);height=int.from_bytes(png[20:24],'big')
    m.adb('shell','input','swipe','12',str(int(height*(.72 if up else .35))),
          '12',str(int(height*(.47 if up else .85))),'200');time.sleep(.25)

def top():
    for _ in range(8):scroll(False)

def byid(tree,name):return next((n for n in m.nodes(tree) if n.get('resource-id','').split('/')[-1]==name),None)
def bounds(node):return list(map(int,re.findall(r'-?\d+',node.get('bounds',''))))

def complete(scale,test_id=None):
    density=int(m.adb('shell','wm','density').strip().split(':')[-1].strip())/160
    result=[]
    for n in m.nodes(m.dump()):
        name=n.get('resource-id','').split('/')[-1]
        if (name==test_id if test_id else re.fullmatch(r'alphabet-[A-Z]|converter-\d+',name)):
            x,y,x1,y1=bounds(n)
            if abs(x1-x-110*scale*density)<=2 and abs(y1-y-150*scale*density)<=2:result.append(name)
    return result

def seek(name=None,desc=None):
    for _ in range(35):
        tree=m.dump();node=byid(tree,name) if name else m.find(tree,desc=desc)
        if node is not None:
            x,y,x1,y1=bounds(node)
            png=m.adb('exec-out','screencap','-p',raw=True);height=int.from_bytes(png[20:24],'big')
            if y1-y>=38 and x1>x and y>=55 and y1<=height-60:return node
        scroll()
    raise AssertionError('Unreachable control: '+str(name or desc))

def click(name):
    x,y,x1,y1=bounds(seek(name));m.adb('shell','input','tap',str((x+x1)//2),str((y+y1)//2));time.sleep(.6)

def cover(prefix,required,theme,scale):
    top();seen=set()
    for page in range(35):
        if complete(scale):seen.update(snapshot(f'{prefix}-{page}',theme,scale))
        if required<=seen:
            m.mark(prefix+'-coverage',expected=sorted(required),observed=sorted(seen));return
        scroll()
    raise AssertionError('Missing complete tile coverage '+str(required-seen))

def matrix():
    m.route('alphabet');m.expect(desc='Play A, Alfa')
    cover('final-alphabet-light',{'alphabet-'+chr(n) for n in range(65,91)},'light',1)
    m.route('converter');m.set_text('NUWJ359')
    required={'converter-'+str(n) for n in range(7)}
    cover('final-converter-light',required,'light',1)
    m.route('settings');m.tap(desc='Dark');m.route('converter');m.set_text('NUWJ359')
    cover('final-converter-dark',required,'dark',1)
    m.adb('shell','settings','put','system','font_scale','2');time.sleep(2)
    cover('final-converter-dark-scale2',required,'dark',2)
    m.route('letter-quiz');seek(desc='5 questions');m.tap(desc='5 questions');click('quiz-start')
    m.expect(contains='Question 1 of 5');top()
    for _ in range(28):
        if complete(2,'quiz-card'):break
        scroll()
    else:raise AssertionError('No complete question tile')
    assert byid(m.dump(),'quiz-card-word') is None
    snapshot('final-quiz-question-dark-scale2','dark',2)
    click('quiz-choice-0');seek(desc='Next question');top()
    for _ in range(28):
        if complete(2,'quiz-card'):break
        scroll()
    else:raise AssertionError('No complete feedback tile')
    snapshot('final-quiz-feedback-dark-scale2','dark',2)
    seek(desc='Next question');m.screenshot('final-quiz-controls-dark-scale2','Reachable production feedback/Next and Replay','dark')
    m.mark('final-dark-quiz-controls',nextPresent=True)

def main():
    p,log=start()
    try:
        m.expect(desc='Light',timeout=45);m.tap(desc='Light');m.route('alphabet');m.expect(desc='Play A, Alfa')
        if '--matrix' in sys.argv:matrix()
        else:snapshot('checkpoint-alphabet-light','light',1)
    finally:
        request('finish',True);p.wait(timeout=20);log.close()
        assert p.returncode==0
        assert 'INSTRUMENTATION_CODE: -1' in (OUT/'observer-session.log').read_text()

if __name__=='__main__':main()
