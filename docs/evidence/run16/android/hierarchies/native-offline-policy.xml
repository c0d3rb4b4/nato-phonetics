d="false" selected="false" bounds="[54,124][74,142]" drawing-order="2" hint="" /><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,135][68,156]" drawing-order="3" hint="" /><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,145][60,156]" drawing-order="4" hint="" /></node></node></node><node index="2" text="Privacy Policy" resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[98,97][622,182]" drawing-order="3" hint="" /></node><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1600]" drawing-order="3" hint=""><node index="0" text="" resource-id="screen-scroll" class="android.widget.ScrollView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1558]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1558]" drawing-order="1" hint=""><node index="8" text="Copy and Share&#10;Only when you tap Copy conversion does the app write the plain text conversion, including not-spoken markers, to the system clipboard. Share conversion passes that same text to the operating system or browser share sheet for you to choose a destination. Clipboard history, synced clipboards and receiving apps have their own controls. Clear input removes the converter text and stops its playback; it does not erase an earlier clipboard copy or shared content." resource-id="privacy-copy-share" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,189][692,281]" drawing-order="9" hint="" /><node index="9" text="Speech and connectivity&#10;Requested playback passes text through the native operating system speech API or directly to the browser’s speech provider on web. Voices, processing location, connectivity and retention depend on that provider. Some voices may use network services. The app does not enforce on-device speech or verify provider retention. Check your provider’s settings and policy before entering sensitive text. Speech output does not request microphone access." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,323][692,808]" drawing-order="10" hint="" /><node index="10" text="Offline availability&#10;Reference and conversion logic run locally once loaded. Audio in airplane mode has not been verified across supported devices." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,849][692,1025]" drawing-order="11" hint="" /><node index="11" text="Deletion and control&#10;Settings → Reset Preferences restores System appearance, System Default voice and converter pace (rate 1×, word pause 300 ms). Reset changes only nato.preferences.v1 and removes its two old migration keys. It keeps unrelated local storage and learning progress. A failed save leaves the previous choice selected and displays an error." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,1067][692,1419]" drawing-order="12" hint="" /><node index="12" text="Clear Progress&#10;Menu → Learning progress → Clear Progress asks you to confirm deletion of nato.progress.v1 and pending unsaved answers. Preferences and unrelated storage are kept. The current round stays in memory; answers submitted after deletion begin new progress. Failed deletion reports an error and keeps progress. This cannot erase device backups." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,1461][692,1558]" drawing-order="13" hint="" /></node></node></node></node></node></node></node></node></node></node></hierarchy>