d="false" selected="false" bounds="[54,124][74,142]" drawing-order="2" hint="" /><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,135][68,156]" drawing-order="3" hint="" /><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,145][60,156]" drawing-order="4" hint="" /></node></node></node><node index="2" text="Privacy Policy" resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[98,97][622,182]" drawing-order="3" hint="" /></node><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1600]" drawing-order="3" hint=""><node index="0" text="" resource-id="screen-scroll" class="android.widget.ScrollView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1558]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1558]" drawing-order="1" hint=""><node index="9" text="Speech and connectivity&#10;Requested playback passes text through the native operating system speech API or directly to the browser’s speech provider on web. Voices, processing location, connectivity and retention depend on that provider. Some voices may use network services. The app does not enforce on-device speech or verify provider retention. Check your provider’s settings and policy before entering sensitive text. Speech output does not request microphone access." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,189][692,159]" drawing-order="10" hint="" /><node index="10" text="Offline availability&#10;Reference and conversion logic run locally once loaded. Web installation and offline caching have not yet been implemented, so an offline cold launch on web is not guaranteed. Audio in airplane mode has not been verified across supported devices." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,200][692,464]" drawing-order="11" hint="" /><node index="11" text="Deletion and control&#10;Settings → Reset Preferences restores System appearance, System Default voice and converter pace (rate 1×, word pause 300 ms). Reset changes only nato.preferences.v1 and removes its two old migration keys. It keeps unrelated local storage and learning progress. A failed save leaves the previous choice selected and displays an error." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,506][692,858]" drawing-order="12" hint="" /><node index="12" text="Clear Progress&#10;Menu → Learning progress → Clear Progress asks you to confirm deletion of nato.progress.v1 and pending unsaved answers. Preferences and unrelated storage are kept. The current round stays in memory; answers submitted after deletion begin new progress. Failed deletion reports an error and keeps progress. This cannot erase device backups." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,900][692,1252]" drawing-order="13" hint="" /><node index="13" text="Device controls&#10;You can clear this site’s browser storage, clear Android app storage, or delete the iOS app and its data. These broader actions remove other installation data too. Device backups and speech providers have their own controls." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,1294][692,1558]" drawing-order="14" hint="" /></node></node></node></node></node></node></node></node></node></node></hierarchy>