d="false" selected="false" bounds="[54,124][74,142]" drawing-order="2" hint="" /><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,135][68,156]" drawing-order="3" hint="" /><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,145][60,156]" drawing-order="4" hint="" /></node></node></node><node index="2" text="Privacy Policy" resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[98,97][622,182]" drawing-order="3" hint="" /></node><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1600]" drawing-order="3" hint=""><node index="0" text="" resource-id="screen-scroll" class="android.widget.ScrollView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1558]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1558]" drawing-order="1" hint=""><node index="2" text="About this policy&#10;NATO Phonetics provides letter/digit reference, text conversion and letter/digit practice without an account. The authored app has no analytics, advertising or application backend. This describes the current implementation, not a legal compliance certification." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,189][692,182]" drawing-order="3" hint="" /><node index="3" text="Local data&#10;The app uses AsyncStorage (browser storage on web) to store nato.preferences.v1: a version 1 record containing your System, Light or Dark appearance, nullable selectedVoice identifier and optional converterPacing rate and wordPauseMs. Pacing is saved only when you choose it; older records use rate 1× and word pause 300 ms. Input text, playback position and card page are not saved." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,224][692,620]" drawing-order="4" hint="" /><node index="4" text="Updating older preferences&#10;On first use after updating, the app reads the old darkMode and selectedVoice keys. It removes only those legacy keys after the versioned record is saved successfully. A failed migration retains old data and displays a recovery message." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,662][692,926]" drawing-order="5" hint="" /><node index="5" text="Learning progress&#10;Each submitted quiz answer saves a separate nato.progress.v1 record on this device or browser: per-symbol attempts, errors, consecutive-correct step, last-review time and next-due time. All practice modes and listening text alternatives share these totals. There is no account or app cloud sync. No typed response, round recap, practice mode or audio is stored in progress." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,968][692,1364]" drawing-order="6" hint="" /><node index="6" text="Text and practice&#10;Converter text, practice mode, review selection, typed drafts, text alternatives and current quiz answers/recaps stay in memory. Closing or reloading clears them. No microphone recording or speech recognition is currently implemented." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,1405][692,1558]" drawing-order="7" hint="" /></node></node></node></node></node></node></node></node></node></node></hierarchy>