able="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1558]" drawing-order="1" hint=""><node index="2" text="" resource-id="" class="android.widget.Button" package="com.natophonetics.app" content-desc="Play audio test" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,189][692,4]" drawing-order="3" hint="" /><node index="3" text="If you cannot hear speech" resource-id="" class="android.view.View" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,189][692,150]" drawing-order="4" hint="" /><node index="4" text="Check media volume, connected headphones and Bluetooth audio. On a physical iPhone, turn off silent mode. Try System Default or another installed English voice. Install voices using your device speech settings, then retry the voice list." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,189][692,405]" drawing-order="5" hint="" /><node index="5" text="" resource-id="" class="android.widget.Button" package="com.natophonetics.app" content-desc="Choose a voice" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,454][692,541]" drawing-order="6" hint=""><node index="0" text="Choose a voice" resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[264,478][455,516]" drawing-order="1" hint="" /></node><node index="6" text="Playback and privacy" resource-id="" class="android.view.View" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,576][692,638]" drawing-order="7" hint="" /><node index="7" text="Letter Quiz includes listening practice with Play code word, Stop and a text alternative when you cannot use audio. Typed recall uses the canonical code word without a microphone. Listening text alternatives count toward the same practice score; pronunciation guides are not alternative typed answers." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,673][692,937]" drawing-order="8" hint="" /><node index="8" text="Starting another card, phrase, quiz answer or preview replaces the current audio. Stop, leaving the screen, editing converter text or backgrounding the app cancels the remaining words and pauses. If a provider does not finish, playback times out with a retry message." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,986][692,1250]" drawing-order="9" hint="" /><node index="9" text="Audio uses your device or browser speech provider. Some voices need a network connection. The app does not verify where a provider processes text, guarantee offline speech, or request microphone access for playback. Pronunciation varies by voice; the written guide remains available." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,1299][692,1558]" drawing-order="10" hint="" /></node></node></node></node></node></node></node></node></node></node></hierarchy>