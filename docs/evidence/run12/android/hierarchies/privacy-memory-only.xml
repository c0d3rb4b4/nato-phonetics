d="false" selected="false" bounds="[54,124][74,142]" drawing-order="2" hint="" /><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,135][68,156]" drawing-order="3" hint="" /><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,145][60,156]" drawing-order="4" hint="" /></node></node></node><node index="2" text="Privacy Policy" resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[98,97][622,182]" drawing-order="3" hint="" /></node><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1600]" drawing-order="5" hint=""><node index="0" text="" resource-id="screen-scroll" class="android.widget.ScrollView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1558]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,189][720,1558]" drawing-order="1" hint=""><node index="2" text="About this policy&#10;NATO Phonetics provides letter/digit reference, text conversion and letter/digit practice without an account. The authored app has no analytics, advertising or application backend. This describes the current implementation, not a legal compliance certification." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,189][692,161]" drawing-order="3" hint="" /><node index="3" text="Local data&#10;The app uses AsyncStorage (browser storage on web) to store nato.preferences.v1: a version 1 record containing your System, Light or Dark appearance, nullable selectedVoice identifier and optional converterPacing rate and wordPauseMs. Pacing is saved only when you choose it; older records use rate 1× and word pause 300 ms. Input text, playback position and card page are not saved." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,203][692,599]" drawing-order="4" hint="" /><node index="4" text="Updating older preferences&#10;On first use after updating, the app reads the old darkMode and selectedVoice keys. It removes only those legacy keys after the versioned record is saved successfully. A failed migration retains old data and displays a recovery message." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,641][692,905]" drawing-order="5" hint="" /><node index="5" text="Text and practice&#10;Converter text, practice mode, typed drafts, text alternatives and current quiz answers stay in memory; the app does not intentionally persist them. No microphone recording, speech recognition or local progress storage is currently implemented." resource-id="" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,947][692,1211]" drawing-order="6" hint="" /><node index="6" text="Copy and Share&#10;Only when you tap Copy conversion does the app write the plain text conversion, including not-spoken markers, to the system clipboard. Share conversion passes that same text to the operating system or browser share sheet for you to choose a destination. Clipboard history, synced clipboards and receiving apps have their own controls. Clear input removes the converter text and stops its playback; it does not erase an earlier clipboard copy or shared content." resource-id="privacy-copy-share" class="android.widget.TextView" package="com.natophonetics.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,1253][692,1558]" drawing-order="7" hint="" /></node></node></node></node></node></node></node></node></node></node></hierarchy>