index 8736d3cb8f..b8378449c1 100644
--- a/tests/YGRoundingLargeOffsetTest.cpp
+++ b/tests/YGRoundingLargeOffsetTest.cpp
@@ -17,30 +17,38 @@ static YGSize _measureTwoLines(
   return YGSize{292.0f, 44.0f};
 }
 
