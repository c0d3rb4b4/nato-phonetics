se" selected="false" bounds="[42,63][1038,1665]" drawing-order="15" hint="" /><node index="15" text="Copy and Share" resource-id="" class="android.view.View" package="com.natophonetics.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,63][1038,23]" drawing-order="16" hint="" /><node index="16" text="Only when you tap Copy conversion does the app write the plain text conversion, including not-spoken markers, to the system clipboard. Share conversion passes that same text to the operating system or browser share sheet for you to choose a destination. Clipboard history, synced clipboards and receiving apps have their own controls. Editing the converter text stops playback. Manage earlier copies or shares through your clipboard or the receiving app." resource-id="" class="android.widget.TextView" package="com.natophonetics.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,63][1038,1665]" drawing-order="17" hint="" /><node index="17" text="Speech and connectivity" resource-id="" class="android.view.View" package="com.natophonetics.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1697][1038,1803]" drawing-order="18" hint="" /><node index="18" text="Requested playback passes text through the native operating system speech API or directly to the browser’s speech provider on web. Voices, processing location, connectivity and retention depend on that provider. Some voices may use network services. The app does not enforce on-device speech or verify provider retention. Check your provider’s settings and policy before entering sensitive text. Speech output does not request microphone access." resource-id="" class="android.widget.TextView" package="com.natophonetics.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1813][1038,2200]" drawing-order="19" hint="" /></node></node><node index="1" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2200][1080,2400]" drawing-order="5" hint=""><node index="0" text="" resource-id="bottom-navigation" class="android.view.ViewGroup" package="com.natophonetics.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2201][1080,2337]" drawing-order="1" hint="" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.natophonetics.app.dev" content-desc="Reference" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2201][270,2337]" drawing-order="2" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[104,2238][167,2301]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.natophonetics.app.dev" con