<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.natophonetics.fonttest">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
  <application android:debuggable="true" android:label="Font scale regression">
    <service android:name=".FontTestIme" android:label="Font regression IME" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
      <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/font_test_ime" />
    </service>
    <receiver android:name=".FontTestImeCommand" android:exported="true" />
  </application>
  <instrumentation android:name="com.natophonetics.fonttest.FontScaleInstrumentation" android:targetPackage="com.natophonetics.app" />
</manifest>
