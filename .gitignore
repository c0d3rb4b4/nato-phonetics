# Dependencies
node_modules/
.bundle/
vendor/bundle/

# Build output
dist/
web-build/
artifacts/
coverage/
playwright-report/
test-results/
logs/
/docs/evidence/

# Native build caches and products (keep the Android/iOS source projects)
.gradle/
.cxx/
.kotlin/
android/**/build/
ios/build/
ios/Pods/
DerivedData/
*.xcresult/
*.dSYM/
*.app/
*.apk
*.aab
*.ipa
*.bcsymbolmap

# Machine-specific native settings and Xcode user state
android/local.properties
ios/.xcode.env.local
**/xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.local.xcconfig

# Signing material; the standard public development key is required for debug builds
*.keystore
!/android/app/debug.keystore
*.pfx
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# Local tool logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.orig.*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local environment files (keep shareable templates)
.env
.env.*
!.env.example
!.env.*.example

# TypeScript and Python caches
*.tsbuildinfo
__pycache__/
*.py[cod]
